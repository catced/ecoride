{% extends 'base.html.twig' %}

{% block title %}Espace utilisateur{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="col-md-6 ms-5">
        <h1 class="mb-3">Bienvenue {{ app.user.name }} !</h1>

        <p>Choisissez votre rôle :</p>
        <form method="post" action="{{ path('set_role') }}">
            <div class="d-flex gap-4">
                <label>
                    <input type="radio" name="choix" value="passager" {% if app.session.get('role') == 'passager' %}checked{% endif %}> Passager
                </label>
                <label>
                    <input type="radio" name="choix" value="chauffeur" {% if app.session.get('role') == 'chauffeur' %}checked{% endif %}> Chauffeur
                </label>
                <label>
                    <input type="radio" name="choix" value="chauffeur-passager" {% if app.session.get('role') == 'chauffeur-passager' %}checked{% endif %}> Chauffeur-Passager
                </label>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Enregistrer le rôle</button>
        </form>

        {% set role = app.session.get('role') %}

        {% if role == 'passager' %}
            {% include 'partials/passenger_section.html.twig' %}
            {# <div class="mt-3">
                <a href="{{ path('app_mes_voyages') }}" class="btn btn-secondary btn-sm w-100">Voir mes réservations</a>
            </div> #}

        {% elseif role == 'chauffeur' %}
            {% include 'partials/driver_section.html.twig' %}

        {% elseif role == 'chauffeur-passager' %}
            {% include 'partials/passenger_section.html.twig' %}
            {% include 'partials/driver_section.html.twig' %}
        {% endif %}

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let filterForm = document.getElementById("filter-form");
        let rideFormContainer = document.getElementById("ride-form-container");
        let passengerRides = document.getElementById("passenger-rides");
        let role = "{{ role }}";

        if (role === "passager") {
            filterForm.style.display = "block";
            if (rideFormContainer) rideFormContainer.style.display = "none";
            if (passengerRides) passengerRides.style.display = "block";
        } else if (role === "chauffeur") {
            filterForm.style.display = "none";
            if (rideFormContainer) rideFormContainer.style.display = "block";
            if (passengerRides) passengerRides.style.display = "none";
        } else if (role === "chauffeur-passager") {
            filterForm.style.display = "none";
            if (rideFormContainer) rideFormContainer.style.display = "block";
            if (passengerRides) passengerRides.style.display = "block";
        }

        document.querySelectorAll('input[name="choix"]').forEach(radio => {
            radio.addEventListener('change', function () {
                let choix = this.value;
                let proposerVoyage = document.getElementById("ride-form-container");

                if (choix === "passager") {
                    filterForm.style.display = "block";
                    if (proposerVoyage) proposerVoyage.style.display = "none";
                    if (passengerRides) passengerRides.style.display = "block";
                } else if (choix === "chauffeur" || choix === "chauffeur-passager") {
                    filterForm.style.display = "none";
                    if (proposerVoyage) proposerVoyage.style.display = "block";
                    if (passengerRides) passengerRides.style.display = "none";
                }

                fetch("{{ path('set_role') }}", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: JSON.stringify({ role: this.value })
                }).then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            location.reload();
                        }
                    });
            });
        });
    });
</script>
{% endblock %}
