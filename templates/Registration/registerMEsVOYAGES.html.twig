{% extends 'base.html.twig' %}

{% block title %}Mes Voyages{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row ms-5 custom-offset">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4 text-center">Mes Voyages</h1>

            <!-- Voyages à venir -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h2 class="h4">Voyages à venir</h2>
                </div>
                <div class="card-body">
                    {% if voyagesavenir|default([]) is not empty %}
                        <ul class="list-group">
                            {% for voyage in voyagesavenir %}
                                <li class="list-group-item">
                                    <strong>{{ voyage.ride.departure }} ? {{ voyage.ride.destination }}</strong>
                                    <br>Date : {{ voyage.ride.departureday|date('d/m/Y') }}
                                    <br>Effectué par : <span class="fw-bold">{{ voyage.ride.driver.pseudo }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted">Aucun voyage à venir.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Voyages effectués -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h2 class="h4">Voyages effectués</h2>
                </div>
                <div class="card-body">
                    {% if voyagespasses|default([]) is not empty %}
                        <ul class="list-group">
                            {% for voyage in voyagespasses %}
                                <li class="list-group-item">
                                    <strong>{{ voyage.ride.departure }} ? {{ voyage.ride.destination }}</strong>
                                    <br>Date : {{ voyage.ride.departureday|date('d/m/Y') }}
                                    <br>Effectué par : <span class="fw-bold">{{ voyage.ride.driver.pseudo }}</span>

                                    {% if voyage.ride.status == 'completed' %}
                                        {% set review = null %}
                                        {% for r in voyage.ride.reviews %}
                                            {% if r.passenger == app.user %}
                                                {% set review = r %}
                                            {% endif %}
                                        {% endfor %}
                                        
                                        {% if review is not null %}
                                            <button class="btn btn-secondary btn-sm mt-2" disabled>Avis déjà donné</button>
                                        {% else %}
                                            <form action="{{ path('ride_review', {'id': voyage.ride.id}) }}" method="post" class="mt-3">
                                                <div class="mb-2">
                                                    <label for="rating_{{ voyage.ride.id }}" class="form-label">Note (1 à 5) :</label>
                                                    <select name="rating" id="rating_{{ voyage.ride.id }}" class="form-select">
                                                        <option value="1">1</option>
                                                        <option value="2">2</option>
                                                        <option value="3">3</option>
                                                        <option value="4">4</option>
                                                        <option value="5">5</option>
                                                    </select>
                                                </div>

                                                <div class="mb-2">
                                                    <label for="comment_{{ voyage.ride.id }}" class="form-label">Votre avis :</label>
                                                    <textarea name="comment" id="comment_{{ voyage.ride.id }}" class="form-control" rows="3"></textarea>
                                                </div>

                                                <button type="submit" class="btn btn-primary btn-sm">Envoyer</button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted">Aucun voyage effectué.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const passwordField = document.querySelector("#registration_form_plainPassword_first");
        const submitButton = document.querySelector("button[type='submit']");

        passwordField.addEventListener("input", function () {
            const password = passwordField.value;
            const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/;
            if (regex.test(password)) {
                passwordField.classList.remove("is-invalid");
                submitButton.disabled = false;
            } else {
                passwordField.classList.add("is-invalid");
                submitButton.disabled = true;
            }
        });
    });
</script>
{% endblock %}