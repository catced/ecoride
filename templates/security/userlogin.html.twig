{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="body">
    <div class="col-md-4 ms-5"> <!-- Réduction de largeur et alignement à gauche -->
        <h1>Connexion</h1>

        <form method="post">
            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="form-group d-flex align-items-center">
                <label class="col-md-4" for="inputEmail">Email</label>
                <div class="col-md-5">
                    <input type="email" value="{{ last_username|default('') }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
                </div>
            </div>

            <div class="form-group d-flex align-items-center mt-2">
                <label class="col-md-4" for="inputPassword">Mot de passe</label>
                <div class="col-md-5">
                    <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-primary mt-3" type="submit">Connexion</button>
        </form>
    </div>
</div>
{% endblock %}
