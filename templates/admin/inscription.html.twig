{% extends 'base.html.twig' %}

{% block title %}Inscription à une activité{% endblock %}

{% block stylesheets %}
   
{% endblock %}

{% block body %}
    <h1>Inscription à une activité</h1>
   
    <div class="container mt-5">
      
        {{ form_start(form, {'attr': {'class': 'activite-form'}}) }}
        <div class="form-row align-items-center">
            <div class="col-auto my-1">
                {{ form_label(form.nom, null, {'label_attr': {'class': 'mr-2'}}) }}
                {{ form_widget(form.nom, {'attr': {'class': 'form-control mb-2'}}) }}
            </div>
        </div>
        <div class="form-row align-items-center">
            <div class="col-auto my-1">
                {{ form_label(form.description, null, {'label_attr': {'class': 'mr-2'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control mb-2'}}) }}
            </div>
        </div>
        <div class="form-row align-items-center">
            <div class="col-auto my-1">
                {{ form_label(form.date, null, {'label_attr': {'class': 'mr-2'}}) }}
                {{ form_widget(form.date, {'attr': {'class': 'form-control mb-2'}}) }}
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">S'inscrire</button>
    {{ form_end(form) }}
    </div>
{% endblock %}
